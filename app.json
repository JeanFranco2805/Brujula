{
  "expo": {
    "name": "Brújula",
    "slug": "brujula-estudio",
    "scheme": "brujula",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Brújula usa el micrófono para grabar tus apuntes de estudio."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Brújula necesita administrar las sesiones que agregues al calendario de tu dispositivo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5145E5",
          "defaultChannel": "study-reminders"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-sharing",
      [
        "llama.rn",
        {
          "enableOpenCLAndHexagon": false
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-localization"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.brujula.estudio",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
